#
# server/.env.example — 운영자 배포용 환경변수 예시.
# 실제 .env 파일에는 진짜 키를 넣고, 절대 저장소에 커밋하지 마세요(.gitignore 로 제외).
#
# 이 프록시만 키를 알며, 브라우저/프런트엔드는 키를 절대 보지 못합니다.

# 필수: Anthropic API 키 (서버에서만 사용) — 실제 키로 교체하세요.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# 선택: 프록시 포트 (기본 8787)
PORT=8787

# 선택: CORS 허용 오리진 (기본 *). 운영에서는 배포 도메인으로 좁히세요.
# 예: ALLOW_ORIGIN=https://clsoftlab-lang.github.io
ALLOW_ORIGIN=*

# 선택: 비용 우선 기본 모델(기본 claude-haiku-4-5). 품질 상향 시 claude-sonnet-5 / claude-opus-5.
AI_MODEL=claude-haiku-4-5

# 선택: Sonnet/Opus 전용 effort (기본 low). Haiku 는 thinking/effort 를 무시합니다.
AI_EFFORT=low

# 선택: 비용 가드레일 — IP당 분당 요청 상한(기본 20), 월 토큰 예산(기본 2000000).
# 초과 시 429 {fallback:true} → 프런트가 내장 mock 으로 자동 폴백.
AI_RATE_PER_MIN=20
AI_MONTHLY_TOKEN_CAP=2000000
